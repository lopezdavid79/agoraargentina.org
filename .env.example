# Copiar a `.env` y completar con valores reales. NUNCA commitear `.env`.
# Los valores existentes corresponden a la app Express/Firebase actual;
# los de Supabase los usa el ETL de migración de capacitaciones (PR6).

# ── App Express actual (config/validateEnv.js) ────────────────
SESSION_SECRET=reemplazar-por-secreto-largo
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreemplazar\n-----END PRIVATE KEY-----
EMAIL_USER=no-reply@agoraargentina.ar
EMAIL_PASS=reemplazar
PORT=3000

# ── ETL capacitaciones → Supabase (scripts/ del PR6) ───────────
# URL del proyecto Supabase (panel → Settings → API).
SUPABASE_URL=https://XXXX.supabase.co
# service_role key (solo scripts de servidor/ETL, NUNCA en el cliente).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Cadena de conexión Postgres para pg_dump (backups pre/post carga).
DATABASE_URL=postgresql://postgres.XXXX:password@aws-0-XXXX.pooler.supabase.com:5432/postgres
